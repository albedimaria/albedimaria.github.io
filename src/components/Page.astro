---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import CallProof from './CallProof.astro';
import Blocks from './Blocks.astro';
import Agencies from './Agencies.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import BackToTop from './BackToTop.astro';
import D10SDock from './D10SDock.astro';
import D10SPanel from './D10SPanel.astro';
import { copy, d10sShell, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Layout lang={lang}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <CallProof lang={lang} />
    <Blocks lang={lang} />
    <Agencies lang={lang} />
    <About lang={lang} />
    <Contact lang={lang} />
  </main>

  <footer class="border-t border-bone/10 bg-ink">
    <div class="wrap flex flex-wrap items-center justify-between gap-2 py-7 text-[15px] text-text-dim">
      <span>© 2026 Alberto Di Maria</span>
      <span>{copy[lang].footer}</span>
    </div>
  </footer>

  <nav aria-label={d10sShell[lang].shortcuts}>
    <BackToTop />
    <D10SDock lang={lang} />
  </nav>
  <D10SPanel lang={lang} />
</Layout>
