---
import { copy, certifications, experience, education, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].about;

const lists = [
  { id: 'certifications', title: t.certifications, items: certifications[lang] },
  { id: 'experience', title: t.experience, items: experience[lang] },
  { id: 'education', title: t.education, items: education[lang] },
];
---

<section id="about" class="bg-ink">
  <div class="wrap grid gap-y-10 py-16 lg:grid-cols-[320px_minmax(0,1fr)] lg:gap-x-[88px] lg:py-[104px]">
    <div class="about-photo w-[200px] overflow-hidden rounded-[var(--radius-card)] border border-bone/10 bg-surface lg:w-auto lg:self-start">
      <img src="/images/alberto.webp" alt={t.photoAlt} loading="lazy" decoding="async" width="900" height="900" class="aspect-[4/5] w-full object-cover" />
    </div>

    <div class="flex min-w-0 flex-col gap-7">
      <h2 class="font-display text-[clamp(44px,11vw,60px)] font-[550] leading-none tracking-[-0.012em] text-bone">{t.title}</h2>
      <p class="max-w-[760px] font-display text-[clamp(22px,6vw,28px)] leading-[1.35] text-bone">{t.lead}</p>
      {t.body.map((p) => <p class="max-w-[760px] text-[clamp(17px,4.6vw,19px)] leading-[1.6] text-text-muted">{p}</p>)}

      <div class="grid gap-x-8 gap-y-5 border-t border-bone/12 pt-6 sm:grid-cols-3">
        {t.facts.map((f) => (
          <div class="flex flex-col gap-1">
            <span class="text-[15px] text-text-dim">{f.label}</span>
            <span class="text-[18px] text-bone">{f.value}</span>
          </div>
        ))}
        <a href="/cv.pdf" class="about-link">{t.cv}</a>
        <a href="https://www.linkedin.com/in/di-maria-alberto/" target="_blank" rel="noopener noreferrer" class="about-link">LinkedIn</a>
        <a href="https://github.com/albedimaria" target="_blank" rel="noopener noreferrer" class="about-link">GitHub</a>
      </div>

      <div class="border-b border-bone/12">
        {lists.map((l) => (
          <details class="about-list" id={l.id}>
            <summary>
              {l.title}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </summary>
            <ul>
              {l.items.map((e) => (
                <li>
                  <h3>{e.title}</h3>
                  <p class="about-meta">{e.meta}</p>
                  {e.desc && <p class="about-desc">{e.desc}</p>}
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
