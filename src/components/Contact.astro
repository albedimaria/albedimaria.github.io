---
import { copy, BOOK_URL, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].contact;
const book = copy[lang].nav.book;

// Web3Forms access key — public by design (it only routes the form to
// Alberto's inbox). The form posts straight to Web3Forms: no backend.
const WEB3FORMS_KEY = '730cfe53-7f78-4bb5-90cf-ee5be2bae7c7';
---

<section id="contact" class="bg-ink-2">
  <div class="wrap grid gap-y-12 py-16 lg:grid-cols-[minmax(0,1fr)_520px] lg:gap-x-24 lg:py-[112px]">
    <div class="flex flex-col gap-7">
      <h2 class="font-display text-[clamp(52px,14vw,88px)] font-[550] leading-[0.98] tracking-[-0.015em] text-bone">
        {t.title[0]}<br />{t.title[1]}
      </h2>
      <p class="text-[20px] leading-[1.5] text-text-muted">{t.lines[0]}<br />{t.lines[1]}</p>
      <a href={BOOK_URL} class="btn-primary btn-lg w-full sm:w-auto sm:self-start">{book}</a>
    </div>

    <!-- No-JS fallback: posts straight to Web3Forms. With JS the inline script
         intercepts and shows the status without leaving the page. -->
    <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="flex min-w-0 flex-col gap-[18px]">
      <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
      <input type="hidden" name="subject" value="New message from albertodimaria.com" />
      <input type="hidden" name="from_name" value="Portfolio · D10S" />
      <!-- honeypot: bots fill it, humans never see it -->
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <p class="text-[17px] text-text-muted">{t.formIntro}</p>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="field">
          <span>{t.name}</span>
          <input type="text" name="name" required autocomplete="name" data-err-msg={t.errName} aria-describedby="err-name" />
          <span id="err-name" class="ferr" data-err aria-live="polite"></span>
        </label>
        <label class="field">
          <span>{t.email}</span>
          <input type="email" name="email" required autocomplete="email" data-err-msg={t.errEmail} aria-describedby="err-email" />
          <span id="err-email" class="ferr" data-err aria-live="polite"></span>
        </label>
      </div>

      <label class="field">
        <span>{t.message}</span>
        <textarea name="message" required rows="5" data-err-msg={t.errMessage} aria-describedby="err-message"></textarea>
        <span id="err-message" class="ferr" data-err aria-live="polite"></span>
      </label>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <button type="submit" data-send={t.send} data-sending={t.sending} class="btn-ghost btn-md disabled:opacity-60">{t.send}</button>
        <a href="mailto:ing.albertodimaria@gmail.com" class="contact-alt inline-flex min-h-11 items-center text-[16px] text-text-muted underline underline-offset-4 transition-colors hover:text-bone">{t.orEmail}</a>
      </div>

      <p id="contact-status" role="status" aria-live="polite" class="hidden text-[16px]" data-success={t.success} data-error={t.error}></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  if (form && status) {
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const label = btn.dataset.send!;
    const sending = btn.dataset.sending!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = sending;
      status.classList.add('hidden');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        // Web3Forms can answer HTTP 200 with { success: false } (rejected key,
        // blocked origin…). Trusting res.ok alone would show "sent" on a message
        // that never leaves — a silently lost lead. Trust the payload.
        const payload = await res.json().catch(() => null);
        const ok = res.ok && payload?.success === true;
        status.textContent = ok ? status.dataset.success! : status.dataset.error!;
        status.classList.remove('hidden');
        status.classList.toggle('is-ok', ok);
        status.style.color = ok ? 'var(--color-bone)' : 'var(--color-accent-txt)';
        if (ok) form.reset();
      } catch {
        status.textContent = status.dataset.error!;
        status.classList.remove('hidden');
        status.style.color = 'var(--color-accent-txt)';
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });

    // Inline validation — checks on blur, clears as the user fixes it.
    const rules: Record<string, (v: string) => boolean> = {
      name: (v) => v.trim().length > 0,
      email: (v) => /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v.trim()),
      message: (v) => v.trim().length >= 4,
    };
    (['name', 'email', 'message'] as const).forEach((n) => {
      const input = form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement | null;
      if (!input) return;
      const err = document.getElementById(`err-${n}`);
      const check = () => {
        const bad = input.value.length > 0 && !rules[n](input.value);
        const empty = input.value.trim().length === 0;
        const show = bad || empty;
        if (err) err.textContent = show ? (input.dataset.errMsg || '') : '';
        input.classList.toggle('is-invalid', show);
        input.setAttribute('aria-invalid', show ? 'true' : 'false');
      };
      input.addEventListener('blur', check);
      input.addEventListener('input', () => {
        if (input.classList.contains('is-invalid') && rules[n](input.value)) {
          if (err) err.textContent = '';
          input.classList.remove('is-invalid');
          input.setAttribute('aria-invalid', 'false');
        }
      });
    });
  }
</script>
