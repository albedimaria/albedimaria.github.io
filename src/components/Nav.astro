---
import BrandMark from './BrandMark.astro';
import { copy, langLabels, localizedHome, langs, BOOK_URL, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].nav;

const navItems = [
  { href: '#work', label: t.work },
  { href: '#agencies', label: t.agencies },
  { href: '#about', label: t.about },
];
---

<header class="sticky top-0 z-30 border-b border-bone/10 bg-ink/85 backdrop-blur">
  <nav class="wrap relative flex h-[76px] items-center gap-4" aria-label="Primary">
    <div class="flex items-center gap-2">
      <BrandMark />
      <a href="#top" class="flex h-11 items-center font-display text-[18px] font-[550] text-bone">Alberto Di Maria</a>
    </div>

    <!-- desktop nav — centered on the page, independent of the side widths -->
    <ul class="hidden gap-9 text-[15px] text-text-muted lg:absolute lg:left-1/2 lg:flex lg:-translate-x-1/2">
      {navItems.map((i) => (
        <li><a href={i.href} class="nav-link">{i.label}</a></li>
      ))}
    </ul>

    <div class="ml-auto hidden items-center gap-3 lg:flex">
      <div class="relative">
        <button id="lang-btn" type="button" class="nav-link inline-flex h-11 items-center gap-1.5 px-3 text-[15px] text-text-muted" aria-haspopup="true" aria-expanded="false" aria-label={t.language}>
          {langLabels[lang]}
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>
        <ul id="lang-menu" class="absolute right-0 mt-1 hidden min-w-[72px] overflow-hidden rounded-[var(--radius-btn)] border border-bone/15 bg-surface py-1">
          {langs.map((l) => (
            <li>
              <a href={localizedHome[l]} data-lang-link class:list={['flex min-h-11 items-center px-4 text-[15px] transition-colors hover:bg-ink-2', l === lang ? 'text-bone' : 'text-text-muted hover:text-bone']} aria-current={l === lang ? 'true' : undefined}>
                {langLabels[l]}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <a href={BOOK_URL} class="btn-primary">{t.book}</a>
    </div>

    <button id="menu-btn" type="button" class="-mr-2.5 ml-auto flex h-11 w-11 items-center justify-center text-bone lg:hidden" aria-label={t.menuOpen} aria-expanded="false" aria-controls="mobile-menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M4 8h16" /><path d="M4 16h16" />
      </svg>
    </button>
  </nav>
</header>

<!-- mobile full-screen menu — OUTSIDE <header> so its fixed positioning is the viewport,
     not the backdrop-filtered header (which would confine and clip it) -->
<div id="mobile-menu" class="fixed inset-0 z-50 hidden bg-ink lg:hidden">
  <div class="wrap flex h-[76px] items-center justify-end border-b border-bone/10">
    <button id="menu-close" type="button" class="-mr-2.5 flex h-11 w-11 items-center justify-center text-bone" aria-label={t.menuClose}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12" /><path d="M18 6L6 18" />
      </svg>
    </button>
  </div>
  <div class="wrap flex flex-1 flex-col justify-center gap-10 pb-10">
    <ul class="flex flex-col gap-6 font-display text-[40px] leading-none text-bone">
      {navItems.map((i) => (
        <li><a href={i.href} class="inline-block py-1">{i.label}</a></li>
      ))}
    </ul>
    <a href={BOOK_URL} class="btn-primary btn-lg self-start">{t.book}</a>
    <div class="flex gap-2 border-t border-bone/10 pt-6 text-[17px]">
      {langs.map((l) => (
        <a href={localizedHome[l]} data-lang-link class:list={['flex h-11 min-w-11 items-center justify-center px-2', l === lang ? 'text-bone' : 'text-text-muted']} aria-current={l === lang ? 'true' : undefined}>
          {langLabels[l]}
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  // Preserve scroll position when switching language (same layout across locales,
  // so the section stays roughly in place instead of jumping back to the top).
  (() => {
    document.querySelectorAll('[data-lang-link]').forEach((a) =>
      a.addEventListener('click', () => {
        try { sessionStorage.setItem('vc_scroll', String(window.scrollY)); } catch {}
      })
    );
    let y: number | null = null;
    try {
      const s = sessionStorage.getItem('vc_scroll');
      if (s !== null) { y = parseInt(s, 10); sessionStorage.removeItem('vc_scroll'); }
    } catch {}
    if (y !== null) {
      const target = y;
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, target);
      window.addEventListener('load', () => window.scrollTo(0, target));
    }
  })();

  const menuBtn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuClose = document.getElementById('menu-close');

  const openMenu = () => {
    menu?.classList.remove('hidden');
    menu?.classList.add('flex', 'flex-col');
    menuBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const closeMenu = () => {
    menu?.classList.add('hidden');
    menu?.classList.remove('flex', 'flex-col');
    menuBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  menuBtn?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

  const langBtn = document.getElementById('lang-btn');
  const langMenu = document.getElementById('lang-menu');
  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const willOpen = langMenu?.classList.contains('hidden');
    langMenu?.classList.toggle('hidden');
    langBtn.setAttribute('aria-expanded', String(!!willOpen));
  });
  document.addEventListener('click', () => {
    langMenu?.classList.add('hidden');
    langBtn?.setAttribute('aria-expanded', 'false');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMenu();
      langMenu?.classList.add('hidden');
      langBtn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
